<domain type='hvf' id='1' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
    <name>Arch</name>
    <memory unit='KiB'>16777216</memory>
    <currentMemory unit='KiB'>16777216</currentMemory>
    <vcpu placement='static'>8</vcpu>
    <os>
        <type arch='aarch64' machine='virt'>hvm</type>
        <loader readonly='yes' type='pflash' format='raw'>
            /opt/homebrew/share/qemu/edk2-aarch64-code.fd
        </loader>
        <nvram template='/opt/homebrew/share/qemu/edk2-arm-vars.fd' templateFormat='raw' format='raw'>
            /opt/homebrew/var/lib/libvirt/qemu/nvram/Arch_VARS.fd
        </nvram>
        <kernel>/Volumes/code/linux/arch/arm64/boot/Image</kernel>
        <cmdline>root=/dev/vda2 console=ttyAMA0</cmdline>
        <bootmenu enable='no'/>
    </os>
    <features>
        <acpi/>
        <apic/>
        <gic version='3'/>
    </features>
    <cpu mode='custom' match='exact' check='none'>
        <model fallback='forbid'>host</model>
        <topology sockets='4' cores='2' threads='1'/>
        <numa>
            <cell id='0' cpus='0-1' memory='4194304' unit='KiB'/>
            <cell id='1' cpus='2-3' memory='4194304' unit='KiB'/>
            <cell id='2' cpus='4-5' memory='4194304' unit='KiB'/>
            <cell id='3' cpus='6-7' memory='4194304' unit='KiB'/>
        </numa>
    </cpu>
    <clock offset='utc'>
        <timer name='rtc' tickpolicy='catchup'/>
        <timer name='hpet' present='no'/>
        <timer name='pit' tickpolicy='delay'/>
    </clock>
    <on_poweroff>destroy</on_poweroff>
    <on_reboot>restart</on_reboot>
    <on_crash>destroy</on_crash>
    <devices>
        <emulator>/opt/homebrew/bin/qemu-system-aarch64</emulator>
        <disk type='file' device='disk'>
            <driver name='qemu' type='qcow2' cache='none'/>
            <source file='/Volumes/code/ArchLinux.utm/Data/BB208CBD-BFB4-4895-9542-48527C9E5473.qcow2' index='2'/>
            <target dev='vda' bus='virtio'/>
            <address type='pci' domain='0x0000' bus='0x02' slot='0x00' function='0x0'/>
        </disk>
        <controller type='pci' index='0' model='pcie-root'/>
        <controller type='pci' index='1' model='pcie-root-port'>
            <target chassis='1' port='0x8'/>
            <address type='pci' domain='0x0000' bus='0x00' slot='0x01' function='0x0'/>
        </controller>
        <controller type='pci' index='2' model='pcie-root-port'>
            <target chassis='2' port='0x9'/>
            <address type='pci' domain='0x0000' bus='0x00' slot='0x01' function='0x1'/>
        </controller>
        <filesystem type='mount' accessmode='passthrough'>
            <source dir='/Volumes/code'/>
            <target dir='code'/>
            <address type='pci' domain='0x0000' bus='0x03' slot='0x00' function='0x0'/>
        </filesystem>
        <interface type='user'>
            <mac address='52:54:00:1f:51:94'/>
            <model type='virtio'/>
            <alias name='net0'/>
            <address type='pci' domain='0x0000' bus='0x01' slot='0x00' function='0x0'/>
        </interface>
        <serial type='pty'>
            <target type='system-serial' port='0'>
                <model name='pl011'/>
            </target>
            <alias name='ua-serial0'/>
        </serial>
        <console type='pty'>
            <target type='serial' port='0'/>
        </console>
        <controller type='virtio-serial' index='0' ports='5'/>
        <console type='pty'>
            <target type='virtio' port='0'/>
            <alias name='ua-hvc0'/>
            <address type='virtio-serial' controller='0' bus='0' port='1'/>
        </console>
        <console type='pty'>
            <target type='virtio' port='1'/>
            <alias name='ua-hvc1'/>
            <address type='virtio-serial' controller='0' bus='0' port='2'/>
        </console>
        <console type='pty'>
            <target type='virtio' port='2'/>
            <alias name='ua-hvc2'/>
            <address type='virtio-serial' controller='0' bus='0' port='3'/>
        </console>
        <console type='pty'>
            <target type='virtio' port='3'/>
            <alias name='ua-hvc3'/>
            <address type='virtio-serial' controller='0' bus='0' port='4'/>
        </console>
        <memballoon model='virtio'/>
        <audio id='1' type='none'/>
    </devices>
    <seclabel type='none' model='none'/>
    <seclabel type='dynamic' model='dac' relabel='yes'>
        <label>+0:+0</label>
        <imagelabel>+0:+0</imagelabel>
    </seclabel>
    <qemu:commandline>
        <qemu:arg value='-device'/>
        <qemu:arg value='virtio-net,netdev=net0,mac=51:24:09:1c:22:31,addr=0xA'/>
        <qemu:arg value='-netdev'/>
        <qemu:arg value='vmnet-host,id=net0'/>
    </qemu:commandline>
</domain>